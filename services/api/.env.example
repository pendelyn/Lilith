LOCAL_API_TOKEN=
ALPHA_OWNER_ID=local-owner
HOST=127.0.0.1
PORT=3000
# Optional outbound home runner. Set both, or neither. Token must not equal LOCAL_API_TOKEN.
# When the relay is set, LILITH_HOME_STATE_KEY is required: 32 bytes, base64url, distinct from
# LOCAL_API_TOKEN and LILITH_RELAY_TOKEN. It encrypts .lilith-home-runner.json. Never commit that file or the key.
# LILITH_RELAY_URL=https://relay.example.workers.dev
# LILITH_RELAY_TOKEN=
# LILITH_HOME_STATE_KEY=
# Physical iPhone: HOST=0.0.0.0 and set apps/mobile EXPO_PUBLIC_API_URL to http://<PC-LAN-IPv4>:3000
